#include "settings_ids.h"

/* Numeric Win32 style bits: the RC compiler in this build does not include
   the Windows SDK headers, so avoid DS_/WS_/CBS_/ES_/BS_/TBS_ symbols. */

/* Sized for the C# dialog's 520x570 client area. The dialog manager maps this
   Segoe UI 9pt template at roughly 1.75 px per horizontal dialog unit and
   1.87 px per vertical dialog unit, so 297x304 units gives 520x570 pixels. */

IDD_SETTINGS DIALOGEX 0, 0, 297, 304
STYLE 0x40 | 0x80 | 0x80000000 | 0x00C00000 | 0x00080000
CAPTION "Micro Task Pager Settings"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_SETTINGS_TABS, "SysTabControl32", 0x00010000, 5, 5, 287, 277
    DEFPUSHBUTTON "Save", IDOK, 189, 286, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 242, 286, 50, 15
    PUSHBUTTON "Defaults", IDC_SETTINGS_DEFAULTS, 5, 286, 50, 15
END

IDD_SETTINGS_LAYOUT DIALOGEX 0, 0, 281, 264
STYLE 0x40 | 0x40000000
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Rendering", -1, 3, 3, 275, 48
    CONTROL "View Mode Default", IDC_VIEW_MODE_LABEL, "Static", 0x50000000 | 0x00000100, 10, 11, 115, 9
    COMBOBOX IDC_VIEW_MODE, 130, 8, 90, 60, 0x0003 | 0x00200000 | 0x00010000
    PUSHBUTTON "R", IDC_REVERT_VIEW_MODE, 258, 8, 16, 15
    CONTROL "Pager Height", IDC_PAGER_HEIGHT_LABEL, "Static", 0x50000000 | 0x00000100, 10, 31, 115, 9
    EDITTEXT IDC_PAGER_HEIGHT, 130, 28, 60, 14, 0x0080
    CONTROL "", IDC_PAGER_HEIGHT_SPIN, "msctls_updown32", 0x0002 | 0x0010 | 0x0020 | 0x0080, 190, 28, 12, 14
    PUSHBUTTON "R", IDC_REVERT_PAGER_HEIGHT, 258, 28, 16, 15

    GROUPBOX "Icons Settings", -1, 3, 55, 275, 48
    CONTROL "Icon Padding X", IDC_ICON_PAD_X_LABEL, "Static", 0x50000000 | 0x00000100, 10, 63, 115, 9
    EDITTEXT IDC_ICON_PAD_X, 130, 60, 60, 14, 0x0080
    CONTROL "", IDC_ICON_PAD_X_SPIN, "msctls_updown32", 0x0002 | 0x0010 | 0x0020 | 0x0080, 190, 60, 12, 14
    PUSHBUTTON "R", IDC_REVERT_ICON_PAD_X, 258, 60, 16, 15
    CONTROL "Icon Padding Y", IDC_ICON_PAD_Y_LABEL, "Static", 0x50000000 | 0x00000100, 10, 83, 115, 9
    EDITTEXT IDC_ICON_PAD_Y, 130, 80, 60, 14, 0x0080
    CONTROL "", IDC_ICON_PAD_Y_SPIN, "msctls_updown32", 0x0002 | 0x0010 | 0x0020 | 0x0080, 190, 80, 12, 14
    PUSHBUTTON "R", IDC_REVERT_ICON_PAD_Y, 258, 80, 16, 15
END

IDD_SETTINGS_THEME DIALOGEX 0, 0, 281, 264
STYLE 0x40 | 0x40000000
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "General", -1, 3, 3, 275, 28
    LTEXT "Background Opacity", -1, 10, 10, 88, 9
    CONTROL "", IDC_OPACITY, "msctls_trackbar32", 0x0001 | 0x00010000, 104, 5, 95, 18
    LTEXT "100%", IDC_OPACITY_LABEL, 204, 10, 22, 9
    PUSHBUTTON "R", IDC_REVERT_OPACITY, 258, 8, 16, 15

    GROUPBOX "Desktops", -1, 3, 35, 275, 88
    LTEXT "Border Style", -1, 10, 43, 115, 9
    COMBOBOX IDC_BORDER_STYLE, 130, 40, 90, 60, 0x0003 | 0x00200000 | 0x00010000
    PUSHBUTTON "R", IDC_REVERT_BORDER_STYLE, 258, 40, 16, 15
    LTEXT "Background Color", -1, 10, 63, 115, 9
    CONTROL "", IDC_DESKTOP_BG_PREVIEW, "Static", 0x50000000 | 0x0000000D, 130, 61, 24, 15
    PUSHBUTTON "Choose...", IDC_DESKTOP_BG, 158, 60, 52, 15
    PUSHBUTTON "R", IDC_REVERT_DESKTOP_BG, 258, 60, 16, 15
    LTEXT "Border Color", -1, 10, 83, 115, 9
    CONTROL "", IDC_DESKTOP_BORDER_PREVIEW, "Static", 0x50000000 | 0x0000000D, 130, 81, 24, 15
    PUSHBUTTON "Choose...", IDC_DESKTOP_BORDER, 158, 80, 52, 15
    PUSHBUTTON "R", IDC_REVERT_DESKTOP_BORDER, 258, 80, 16, 15
    LTEXT "Border Color (Active)", -1, 10, 103, 115, 9
    CONTROL "", IDC_ACTIVE_DESKTOP_BORDER_PREVIEW, "Static", 0x50000000 | 0x0000000D, 130, 101, 24, 15
    PUSHBUTTON "Choose...", IDC_ACTIVE_DESKTOP_BORDER, 158, 100, 52, 15
    PUSHBUTTON "R", IDC_REVERT_ACTIVE_DESKTOP_BORDER, 258, 100, 16, 15

    GROUPBOX "Preview Windows", -1, 3, 127, 275, 88
    LTEXT "Background Color", -1, 10, 135, 115, 9
    CONTROL "", IDC_WINDOW_BG_PREVIEW, "Static", 0x50000000 | 0x0000000D, 130, 133, 24, 15
    PUSHBUTTON "Choose...", IDC_WINDOW_BG, 158, 132, 52, 15
    PUSHBUTTON "R", IDC_REVERT_WINDOW_BG, 258, 132, 16, 15
    LTEXT "Border Color", -1, 10, 155, 115, 9
    CONTROL "", IDC_WINDOW_BORDER_PREVIEW, "Static", 0x50000000 | 0x0000000D, 130, 153, 24, 15
    PUSHBUTTON "Choose...", IDC_WINDOW_BORDER, 158, 152, 52, 15
    PUSHBUTTON "R", IDC_REVERT_WINDOW_BORDER, 258, 152, 16, 15
    LTEXT "Border Color (Active)", -1, 10, 175, 115, 9
    CONTROL "", IDC_ACTIVE_WINDOW_BORDER_PREVIEW, "Static", 0x50000000 | 0x0000000D, 130, 173, 24, 15
    PUSHBUTTON "Choose...", IDC_ACTIVE_WINDOW_BORDER, 158, 172, 52, 15
    PUSHBUTTON "R", IDC_REVERT_ACTIVE_WINDOW_BORDER, 258, 172, 16, 15
    LTEXT "Background Color (Active)", -1, 10, 195, 115, 9
    CONTROL "", IDC_ACTIVE_WINDOW_BG_PREVIEW, "Static", 0x50000000 | 0x0000000D, 130, 193, 24, 15
    PUSHBUTTON "Choose...", IDC_ACTIVE_WINDOW_BG, 158, 192, 52, 15
    PUSHBUTTON "R", IDC_REVERT_ACTIVE_WINDOW_BG, 258, 192, 16, 15
END

IDD_SETTINGS_MISC DIALOGEX 0, 0, 281, 264
STYLE 0x40 | 0x40000000
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Performance", -1, 3, 3, 275, 48
    CONTROL "Primary Update Delay (ms)", IDC_PRIMARY_DELAY_LABEL, "Static", 0x50000000 | 0x00000100, 10, 11, 135, 9
    EDITTEXT IDC_PRIMARY_DELAY, 150, 8, 60, 14, 0x0080
    CONTROL "", IDC_PRIMARY_DELAY_SPIN, "msctls_updown32", 0x0002 | 0x0010 | 0x0020 | 0x0080, 210, 8, 12, 14
    PUSHBUTTON "R", IDC_REVERT_PRIMARY_DELAY, 258, 8, 16, 15
    CONTROL "Secondary Update Delay (ms)", IDC_SECONDARY_DELAY_LABEL, "Static", 0x50000000 | 0x00000100, 10, 31, 135, 9
    EDITTEXT IDC_SECONDARY_DELAY, 150, 28, 60, 14, 0x0080
    CONTROL "", IDC_SECONDARY_DELAY_SPIN, "msctls_updown32", 0x0002 | 0x0010 | 0x0020 | 0x0080, 210, 28, 12, 14
    PUSHBUTTON "R", IDC_REVERT_SECONDARY_DELAY, 258, 28, 16, 15

    GROUPBOX "App Pinning", -1, 3, 59, 275, 100
    CONTROL "Show App In Taskbar", IDC_SHOW_TASKBAR, "Button", 0x0003 | 0x00010000, 10, 67, 150, 12
    PUSHBUTTON "R", IDC_REVERT_SHOW_TASKBAR, 258, 65, 16, 15
    LTEXT "Important: When deactivated, the automatic pinning of the app (to be visible on all virtual desktops) can't work anymore because of a limitation of the Windows OS. So the pinning has to be done manually after every application start using the Active Applications screen (Win + Tab).", -1, 10, 86, 260, 64
END

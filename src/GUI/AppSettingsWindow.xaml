<Window x:Class="MicroTaskPager.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MicroTaskPager.GUI" 
        Title="Micro Task Pager Settings"
        Width="460"
        Height="625"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#111111" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="tabControl" Grid.Row="0">
            <TabItem Header="Layout">
                <ScrollViewer VerticalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">

                        <!--
                        <Label>Layout List</Label>
                        <ListBox Margin="0,0,0,10">
                            <ListBoxItem>Setting 1</ListBoxItem>
                            <ListBoxItem>Setting 2</ListBoxItem>
                            <ListBoxItem>Setting 3</ListBoxItem>
                        </ListBox>
                        -->

                        <GroupBox Header="Rendering" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" ToolTip="Only affects newly created desktops and their screens">View Mode Default</TextBlock>
                                <ComboBox x:Name="cmbViewModeDefault" Grid.Row="0" Grid.Column="1" Margin="8,2,0,2" SelectionChanged="ViewModeDefaultChanged" />
                                <Button x:Name="btnRevertViewModeDefault" Grid.Row="0" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertViewModeDefault_Click" />

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                           ToolTip="The pager's width is automatically calculated from this value and from the size&#10;of all available screen space as well as the amount of virtual desktops.">Pager Height</TextBlock>
                                <local:NumericUpDownControl x:Name="numericPagerHeight" ValueChanged="PagerHeightChanged" Grid.Row="1" Grid.Column="1" Margin="8,2,0,2"/>
                                <Button x:Name="btnRevertPagerHeight" Grid.Row="1" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertPagerHeight_Click" />

                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Icons Settings" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" 
                                           ToolTip="Negative values are supported as well so less space is taken and the icons look stacked.">Icon Padding X</TextBlock>
                                <local:NumericUpDownControl x:Name="numericIconPaddingX" ValueChanged="PaddingInputChanged" Grid.Row="0" Grid.Column="1" Margin="8,2,0,2"/>
                                <Button x:Name="btnRevertIconPaddingX" Grid.Row="0" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertIconPaddingX_Click" />

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" 
                                           ToolTip="Negative values are supported as well in case of a very small pager height&#10;like 40px which is ususally the size of the Windows Taskbar.">Icon Padding Y</TextBlock>
                                <local:NumericUpDownControl x:Name="numericIconPaddingY" ValueChanged="PaddingInputChanged" Grid.Row="1" Grid.Column="1" Margin="8,2,0,2"/>
                                <Button x:Name="btnRevertIconPaddingY" Grid.Row="1" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertIconPaddingY_Click" />

                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Theme">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">

                        <GroupBox Header="General" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">App Background Opacity</TextBlock>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="3,2,0,2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="sldBackgroundOpacity" Width="60" Minimum="0.25" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="BackgroundOpacityChanged" />
                                    <TextBlock x:Name="txtBackgroundOpacityValue" Width="42" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="btnRevertBackgroundOpacity" Grid.Row="1" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertBackgroundOpacity_Click" />
                            </Grid>

                        </GroupBox>

                        <GroupBox Header="Desktops" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Border Style</TextBlock>
                                <ComboBox x:Name="cmbDesktopBorderStyle" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,2,0,2" SelectionChanged="DesktopBorderStyleChanged" />
                                <Button x:Name="btnRevertDesktopBorderStyle" Grid.Row="0" Grid.Column="3" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertDesktopBorderStyle_Click" />

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Background Color</TextBlock>
                                <Border x:Name="previewBackgroundColor" Grid.Row="1" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="1" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseDesktopBackgroundColor_Click" />
                                <Button x:Name="btnRevertBackgroundColor" Grid.Row="1" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertDesktopBackgroundColor_Click" />

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Height="16">Border Color</TextBlock>
                                <Border x:Name="previewDesktopColor" Grid.Row="2" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="2" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseDesktopBorderColor_Click" />
                                <Button x:Name="btnRevertDesktopColor" Grid.Row="2" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertDesktopBorderColor_Click" />

                                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Height="16">Border Color (Active)</TextBlock>
                                <Border x:Name="previewActiveDesktopBorderColor" Grid.Row="3" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="3" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseActiveDesktopBorderColor_Click" />
                                <Button x:Name="btnRevertActiveDesktopBorderColor" Grid.Row="3" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertActiveDesktopBorderColor_Click" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Preview Windows" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Height="16">Background Color</TextBlock>
                                <Border x:Name="previewWindowColor" Grid.Row="0" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="0" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseWindowBackgroundColor_Click" />
                                <Button x:Name="btnRevertWindowColor" Grid.Row="0" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertWindowBackgroundColor_Click" />

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Height="16">Border Color</TextBlock>
                                <Border x:Name="previewWindowBorderColor" Grid.Row="1" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="1" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseWindowBorderColor_Click" />
                                <Button x:Name="btnRevertWindowBorderColor" Grid.Row="1" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertWindowBorderColor_Click" />

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Height="16">Border Color (Active)</TextBlock>
                                <Border x:Name="previewActiveWindowBorderColor" Grid.Row="2" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="2" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseActiveWindowBorderColor_Click" />
                                <Button x:Name="btnRevertActiveWindowBorderColor" Grid.Row="2" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertActiveWindowBorderColor_Click" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Preview Windows &amp; MicroTaskbar Icons" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Height="16">Background Color (Active)</TextBlock>
                                <Border x:Name="previewActiveWindowColor" Grid.Row="0" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="0" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseActiveWindowBackgroundColor_Click" />
                                <Button x:Name="btnRevertActiveWindowColor" Grid.Row="0" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertActiveWindowBackgroundColor_Click" />

                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Misc">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">

                        <GroupBox Header="Performance" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" 
                                           ToolTip="Delay for the main refresh cycle. &#10;Affects how often the currently opened windows &#10;(on all virtual desktops) are checked for changes. &#10;&#10;Lower values update the pager faster, but can increase CPU usage.">Primary Update Delay (ms)</TextBlock>
                                <TextBox x:Name="txtPrimaryDelay" Grid.Row="0" Grid.Column="1" Margin="8,2,0,2" Padding="3" TextChanged="MiscTextInputChanged" ToolTip="Controls how often the primary update runs.&#10;Use milliseconds (ms)." />
                                <Button x:Name="btnRevertPrimaryDelay" Grid.Row="0" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertPrimaryDelay_Click" />

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" 
                                           ToolTip="Delay for background/secondary updates.&#10;Affects how often the app window is checked for being covered by another one, &#10;this includes the Windows Taskbar. Also (re-)pins the app to all virtual desktops.&#10;Furthermore, changes regarding the amount of virtual desktops are detected.&#10;&#10;Some of those operations require more processing,&#10;that's why this delay should be higher than the primary one.">Secondary Update Delay (ms)</TextBlock>
                                <TextBox x:Name="txtSecondaryDelay" Grid.Row="1" Grid.Column="1" Margin="8,2,0,2" Padding="3" TextChanged="MiscTextInputChanged" ToolTip="Controls how often the secondary update runs.&#10;Use milliseconds (ms)." />
                                <Button x:Name="btnRevertSecondaryDelay" Grid.Row="1" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertSecondaryDelay_Click" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="App Pinning" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Show App In Taskbar</TextBlock>
                                <CheckBox x:Name="chkShowAppInTaskbar" Grid.Row="0" Grid.Column="1" Margin="8,2,0,2" VerticalAlignment="Center"
                  Checked="MiscBooleanInputChanged" Unchecked="MiscBooleanInputChanged" />
                                <Button x:Name="btnRevertShowAppInTaskbar" Grid.Row="0" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertShowAppInTaskbar_Click" />

                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="8" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3">
                                    <TextBlock TextWrapping="Wrap" Foreground="#444444">
                Important: When deactivated, the automatic pinning of the app (to be visible on all virtual desktops) can't work anymore because of a limitation of the Windows OS. <LineBreak/> So the pinning has to be done manually after every application start using the "Active Applications" screen (Win + Tab).
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Defaults" Click="ResetToDefaults_Click" ToolTip="Reset for current tab only" />
            <Button Width="100" Margin="0,0,8,0" IsDefault="True" Content="Save" Click="Save_Click" />
            <Button Width="100" IsCancel="True" Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>


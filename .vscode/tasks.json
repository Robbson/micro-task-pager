{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/csharp-winforms/MicroTaskPager.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "pwsh",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/build.ps1",
        "-Target",
        "winforms"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "${workspaceFolder}/csharp-winforms/MicroTaskPager.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "rust-winui build",
      "command": "cargo",
      "type": "process",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/rust-winui"
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "rust-winui run",
      "command": "cargo",
      "type": "process",
      "args": [
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}/rust-winui"
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "rust-winsafe build",
      "command": "cargo",
      "type": "process",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/rust-winsafe"
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "rust-winsafe run",
      "command": "cargo",
      "type": "process",
      "args": [
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}/rust-winsafe"
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "publish rust-winsafe",
      "command": "pwsh",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/build.ps1",
        "-Target",
        "winsafe"
      ],
      "problemMatcher": []
    }
  ]
}
